pragma solidity 0.8.21;

import {BaseTestIntegration} from "test/integrations/BaseTestIntegration.t.sol";
import {ERC20} from "@solmate/tokens/ERC20.sol";
import {LombardBTCMinterDecoderAndSanitizer} from
    "src/base/DecodersAndSanitizers/Protocols/LombardBtcMinterDecoderAndSanitizer.sol";
import {BaseDecoderAndSanitizer} from "src/base/DecodersAndSanitizers/BaseDecoderAndSanitizer.sol";
import {Test, stdStorage, StdStorage, stdError, console} from "@forge-std/Test.sol";

contract FullLombardBTCMinterDecoderAndSanitizer is LombardBTCMinterDecoderAndSanitizer, BaseDecoderAndSanitizer {}

contract LombardBTCMinterIntegration is BaseTestIntegration {
    function _setUpMainnet(uint256 blockNumber) internal {
        super.setUp();
        _setupChain("mainnet", blockNumber);

        address decoder = address(new FullLombardBTCMinterDecoderAndSanitizer());
        _overrideDecoder(decoder);
    }

    function testDecoderExtraction() external {
        // Payload from mainnet tx 0x4c802220da09e4e35a8e1b29967b1dab006c45a7c664ed224882146d9def11b2
        // (block 25070135). Recipient inside msgBody is 0x11919e60...148d6b.
        _setUpMainnet(25070134);

        address realRecipient = 0x11919e601762036C1b00B585Dd031c834e148d6b;

        bytes memory payload =
            hex"";

        bytes memory addressesFound =
            FullLombardBTCMinterDecoderAndSanitizer(rawDataDecoderAndSanitizer).mint(payload, "");

        assertEq(addressesFound, abi.encodePacked(realRecipient));
    }

    // Replays the real on-chain mint(bytes,bytes) call from tx
    // 0x4c802220...def11b2 (mainnet block 25070135). The decoder must extract the
    // recipient from msgBody so the merkle check passes against the overridden leaf.
    function testLombardMintWithRealPayload() external {
        _setUpMainnet(25070134);

        ManageLeaf[] memory leafs = new ManageLeaf[](2);
        _addLombardBTCLeafs(leafs);

        address realRecipient = 0x11919e601762036C1b00B585Dd031c834e148d6b;
        leafs[1].argumentAddresses[0] = realRecipient;

        bytes32[][] memory manageTree = _generateMerkleTree(leafs);
        manager.setManageRoot(address(this), manageTree[manageTree.length - 1][0]);

        Tx memory tx_ = _getTxArrays(1);
        tx_.manageLeafs[0] = leafs[1];

        bytes32[][] memory manageProofs = _getProofsUsingTree(tx_.manageLeafs, manageTree);

        tx_.targets[0] = getAddress(sourceChain, "LBTC");
        tx_.targetData[0] = abi.encodeWithSignature(
            "mint(bytes,bytes)",
            hex"",
            hex""
        );
        tx_.decodersAndSanitizers[0] = rawDataDecoderAndSanitizer;

        uint256 balanceBefore = getERC20(sourceChain, "LBTC").balanceOf(realRecipient);
        _submitManagerCall(manageProofs, tx_);
        uint256 balanceAfter = getERC20(sourceChain, "LBTC").balanceOf(realRecipient);
        assertGt(balanceAfter, balanceBefore, "real recipient must have received LBTC");
    }
}
